From dc2ae731d6935feeb35190fe29e5ef448ae7e1cd Mon Sep 17 00:00:00 2001
From: TuanTNT19 <tuantnt08@gmail.com>
Date: Thu, 3 Jul 2025 20:58:32 +0700
Subject: [PATCH] Test2

---
 .../arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts | 40 ++++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts b/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
index 7608651f8..d3ac967af 100644
--- a/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
+++ b/arch/arm/boot/dts/broadcom/bcm2711-rpi-4-b.dts
@@ -481,4 +481,42 @@ my-leds {
         led23-gpios = <&gpio 23 GPIO_ACTIVE_HIGH>;
         default-state = "off";
     };
-};
\ No newline at end of file
+};
+
+&spi0 {
+    status = "okay";
+    #address-cells = <1>;
+    #size-cells = <0>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&spi0_pins &spi0_cs_pins>;
+    cs-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
+
+    spidev@0 {
+        compatible = "spidev";
+        reg = <0>;
+        status = "disabled"; // Tắt spidev@0 để nhường CS0
+    };
+
+    spidev@1 {
+        compatible = "spidev";
+        reg = <1>;
+        status = "disabled"; 
+    };
+
+    tuantn_display: tuantn-display@0 {
+        compatible = "ilitek,ili9341";
+        reg = <0>;
+        spi-max-frequency = <20000000>;
+        width = <240>;
+        height = <320>;
+        regwidth = <8>;
+        rotate = <180>;
+        fps = <30>;
+        buswidth = <8>;
+        reset-gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
+        dc-gpios = <&gpio 27 GPIO_ACTIVE_HIGH>;
+        led-gpios = <&gpio 22 GPIO_ACTIVE_HIGH>;
+        bgr;
+        status = "okay";
+    };
+};
-- 
2.25.1

