From 0ff6c99a070a748e3bb724c9b73337060aae5856 Mon Sep 17 00:00:00 2001
From: TuanTNT19 <tuantnt08@gmail.com>
Date: Sun, 5 Apr 2026 16:03:39 +0700
Subject: [PATCH] srslog: update sink_stream_type

---
 lib/src/srslog/sinks/stream_sink.h | 4 ++--
 lib/src/srslog/srslog.cpp          | 4 ++--
 lib/src/srslog/srslog_instance.h   | 4 ++--
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/lib/src/srslog/sinks/stream_sink.h b/lib/src/srslog/sinks/stream_sink.h
index c4edaef25..9b9f9dc73 100644
--- a/lib/src/srslog/sinks/stream_sink.h
+++ b/lib/src/srslog/sinks/stream_sink.h
@@ -27,14 +27,14 @@
 namespace srslog {
 
 /// Standard stream types.
-enum class sink_stream_type { stdout, stderr };
+enum class sink_stream_type { out, err };
 
 /// This sink implementation writes to either stdout or stderr streams.
 class stream_sink : public sink
 {
 public:
   stream_sink(sink_stream_type s, std::unique_ptr<log_formatter> f) :
-    sink(std::move(f)), handle((s == sink_stream_type::stdout) ? stdout : stderr)
+    sink(std::move(f)), handle((s == sink_stream_type::out) ? stdout : stderr)
   {}
 
   stream_sink(const stream_sink& other) = delete;
diff --git a/lib/src/srslog/srslog.cpp b/lib/src/srslog/srslog.cpp
index a7a10965e..a46455934 100644
--- a/lib/src/srslog/srslog.cpp
+++ b/lib/src/srslog/srslog.cpp
@@ -136,7 +136,7 @@ sink& srslog::fetch_stdout_sink(const std::string& id, std::unique_ptr<log_forma
   auto& s = srslog_instance::get().get_sink_repo().emplace(
       std::piecewise_construct,
       std::forward_as_tuple(id),
-      std::forward_as_tuple(new stream_sink(sink_stream_type::stdout, std::move(f))));
+      std::forward_as_tuple(new stream_sink(sink_stream_type::out, std::move(f))));
 
   return *s;
 }
@@ -152,7 +152,7 @@ sink& srslog::fetch_stderr_sink(const std::string& id, std::unique_ptr<log_forma
   auto& s = srslog_instance::get().get_sink_repo().emplace(
       std::piecewise_construct,
       std::forward_as_tuple(id),
-      std::forward_as_tuple(new stream_sink(sink_stream_type::stderr, std::move(f))));
+      std::forward_as_tuple(new stream_sink(sink_stream_type::err, std::move(f))));
 
   return *s;
 }
diff --git a/lib/src/srslog/srslog_instance.h b/lib/src/srslog/srslog_instance.h
index a928a88c1..35c8c121c 100644
--- a/lib/src/srslog/srslog_instance.h
+++ b/lib/src/srslog/srslog_instance.h
@@ -39,13 +39,13 @@ class srslog_instance
     auto& stdout_sink =
         sink_repo.emplace(std::piecewise_construct,
                           std::forward_as_tuple("stdout"),
-                          std::forward_as_tuple(new stream_sink(sink_stream_type::stdout,
+                          std::forward_as_tuple(new stream_sink(sink_stream_type::out,
                                                                 std::unique_ptr<log_formatter>(new text_formatter))));
     default_sink = stdout_sink.get();
 
     sink_repo.emplace(std::piecewise_construct,
                       std::forward_as_tuple("stderr"),
-                      std::forward_as_tuple(new stream_sink(sink_stream_type::stderr,
+                      std::forward_as_tuple(new stream_sink(sink_stream_type::err,
                                                             std::unique_ptr<log_formatter>(new text_formatter))));
 
     // Initialize the default formatter pointer with a text formatter.
-- 
2.25.1

